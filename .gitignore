#==============================================================================
# VBA-DATETIMEPICKER .gitignore
#------------------------------------------------------------------------------
# PURPOSE
#   Keep the repository source-first, reviewable, reproducible, and safe to
#   clone. Ignore workstation state, generated output, secrets, caches, and
#   unintended Office packages while preserving authoritative source and
#   repository evidence.
#
# REPOSITORY POLICY
#   - Exported VBA, UF_DatePicker.frm, and UF_DatePicker.frx are version-controlled together.
#   - RibbonX, demo builders, regression source, and dist/README.md are authoritative.
#   - Generated workbooks and add-ins are distributed as GitHub Release assets.
#   - Project-wide editor policy is version-controlled in .editorconfig.
#
# SAFETY RULE
#   Never add broad rules for exported VBA source, documentation, repository
#   automation, or evidence directories. Exceptions for intentional Office
#   packages must use exact rooted paths.
#==============================================================================


#------------------------------------------------------------------------------
# MICROSOFT OFFICE TEMPORARY / LOCK / RECOVERY FILES
#------------------------------------------------------------------------------
~$*
.~lock.*#
*.laccdb
*.ldb

*.tmp
*.temp
*.bak
*.backup
*.xlk
*.asd
*.wbk


#------------------------------------------------------------------------------
# GENERATED OFFICE PACKAGES
#------------------------------------------------------------------------------
# Office packages are generated or release artifacts by default. These global
# rules prevent an accidental workbook saved anywhere in the tree from becoming
# source. Re-include an intentional package only by its exact rooted path.
*.xls
*.xlsx
*.xlsm
*.xlsb
*.xlt
*.xltx
*.xltm
*.xla
*.xlam
*.xll
*.xlw

*.docm
*.dotm
*.pptm
*.potm
*.ppsm
*.accdb
*.accde
*.accdr
*.mdb
*.mde
*.ade

# If a binary fixture becomes authoritative, add one exact rooted exception:
# !/test/fixtures/known-good-example.xlsm


#------------------------------------------------------------------------------
# RELEASE / BUILD STAGING
#------------------------------------------------------------------------------
# Root anchoring prevents a generated-directory name from hiding an
# authoritative nested source or evidence directory.
/release-assets/
/build/
/out/
/output/
/outputs/

# DatePicker distributes from dist/ but keeps its policy document tracked.
/dist/*
!/dist/README.md


#------------------------------------------------------------------------------
# LOCAL TEST / CERTIFICATION OUTPUT
#------------------------------------------------------------------------------
/test-output/
/test-results/
/coverage/
/htmlcov/

.coverage
.coverage.*
coverage.xml

.pytest_cache/
.hypothesis/
.tox/
.nox/

# Repository-specific local run evidence. Root anchoring keeps similarly named
# fixtures or publishable evidence in nested directories visible.
/DATETIMEPICKER_certification_*.json
/DATETIMEPICKER_certification_*.txt


#------------------------------------------------------------------------------
# LOCAL TEMPORARY DIRECTORIES
#------------------------------------------------------------------------------
/temp/
/tmp/
/.cache/


#------------------------------------------------------------------------------
# WINDOWS FILE-SYSTEM / SHELL METADATA
#------------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
System Volume Information/
*.stackdump

# Reserved-name artifact occasionally created by shell redirection mistakes.
nul


#------------------------------------------------------------------------------
# MACOS / NETWORK / UNIX METADATA
#------------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Trashes
.Spotlight-V100
.fseventsd

.directory
.fuse_hidden*
.nfs*


#------------------------------------------------------------------------------
# EDITOR / IDE / LOCAL ASSISTANT STATE
#------------------------------------------------------------------------------
# Project-wide configuration belongs in the repository; personal workspaces do
# not. Re-include a specific shared editor file explicitly if one is introduced.
.vscode/
.idea/
.vs/
.history/
.fleet/

*.code-workspace
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*.swo
*~

*.nppBackup
session.xml

.claude/
.cursor/
.aider*
.continue/


#------------------------------------------------------------------------------
# MERGE / PATCH / CONFLICT ARTIFACTS
#------------------------------------------------------------------------------
*.orig
*.rej
*.patch.tmp


#------------------------------------------------------------------------------
# LOGS / CRASH DUMPS
#------------------------------------------------------------------------------
*.log
*.dmp
*.dump


#------------------------------------------------------------------------------
# LOCAL ENVIRONMENT / SECRET / SIGNING MATERIAL
#------------------------------------------------------------------------------
# Sanitized examples remain trackable.
.env
.env.*
!.env.example

*.pfx
*.p12
*.pvk
*.key
*.pem


#------------------------------------------------------------------------------
# PYTHON CACHE / LOCAL ENVIRONMENTS
#------------------------------------------------------------------------------
# Source, manifests, lock files, and requirements remain trackable.
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
pip-wheel-metadata/

.mypy_cache/
.pyright/
.ruff_cache/
.ipynb_checkpoints/

.venv/
venv/


#------------------------------------------------------------------------------
# NODE / JAVASCRIPT LOCAL DEPENDENCIES
#------------------------------------------------------------------------------
# Package manifests and lock files remain trackable. Only installed dependencies,
# machine caches, and diagnostic logs are ignored.
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz
.yarn/build-state.yml

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


#------------------------------------------------------------------------------
# AUTHORITATIVE CONTENT THAT MUST REMAIN TRACKABLE
#------------------------------------------------------------------------------
# These are documentation guardrails, not negation rules:
#   src/modules/*.bas, src/classes/*.cls
#   src/forms/*.frm, src/forms/*.frx
#   src/ribbon/*.xml, demo/*.bas, test/*.bas
#   dist/README.md, docs/**, *.md
#   assets/**, images/**, .github/**
#   .editorconfig, .gitattributes, .gitignore
#
# Do not ignore exported VBA extensions or authoritative source, documentation,
# benchmark, evidence, asset, or .github directories.
#==============================================================================
