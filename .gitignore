#==============================================================================
# VBA-DATETIMEPICKER .gitignore
#------------------------------------------------------------------------------
# PURPOSE
#   Keep the repository source-first and reviewable.
#
#   Ignore local, temporary, generated, sensitive, and release-binary files
#   while preserving the exported VBA source, UserForm resources, RibbonX,
#   demo builders, regression tests, documentation, workflows, and screenshots
#   that define the project.
#
# REPOSITORY POLICY
#   - Exported VBA source is version-controlled.
#   - UF_DatePicker.frm AND UF_DatePicker.frx are version-controlled together.
#   - RibbonX source (customUI14.xml) is version-controlled.
#   - Demo workbook SOURCE is version-controlled.
#   - Generated .xlsm / .xlam and other Office binaries are NOT source files.
#   - Tested binaries are distributed as GitHub Release assets.
#   - dist/README.md remains version-controlled even though local release
#     binaries may be staged under dist/.
#   - Editor state, logs, caches, build output, local secrets, Office lock files,
#     and OS metadata do not belong in Git.
#
# SAFETY RULE
#   Do not add broad rules that can hide:
#
#       *.bas  *.cls  *.frm  *.frx  *.xml  *.md  assets/  images/  .github/
#
#   Those paths contain authoritative project source or repository evidence.
#==============================================================================


#------------------------------------------------------------------------------
# MICROSOFT OFFICE TEMPORARY / LOCK / RECOVERY FILES
#------------------------------------------------------------------------------
# Office creates owner/lock files beside an open workbook or document.
# The general ~$* rule intentionally covers Excel, Word and PowerPoint forms.
#------------------------------------------------------------------------------

~$*

*.tmp
*.temp
*.bak
*.backup
*.xlk
*.asd
*.wbk

# LibreOffice / OpenOffice lock files that can appear during cross-tool checks.
.~lock.*#


#------------------------------------------------------------------------------
# GENERATED EXCEL / OFFICE BINARIES
#------------------------------------------------------------------------------
# The repository tracks the source used to build the DatePicker, demo workbook,
# and add-in. Generated Office binaries belong in GitHub Releases, not Git.
#
# These rules are global rather than demo/-only or dist/-only. A workbook saved
# accidentally at the repository root, under test/, or in another folder should
# still remain untracked.
#------------------------------------------------------------------------------

# Excel workbooks, templates, add-ins and legacy/binary formats
*.xls
*.xlsx
*.xlsm
*.xlsb
*.xlt
*.xltx
*.xltm
*.xla
*.xlam
*.xll
*.xlw

# Adjacent Office macro/binary formats that are not project source
*.docm
*.dotm
*.pptm
*.potm
*.ppsm
*.accdb
*.accde
*.mdb
*.mde

# If a binary fixture ever genuinely belongs in source control, re-include it
# by EXPLICIT path so that the exception is visible in code review.
#
# Example:
# !test/fixtures/known-good-example.xlsm


#------------------------------------------------------------------------------
# RELEASE-ASSET / LOCAL BUILD STAGING
#------------------------------------------------------------------------------
# Keep dist/README.md and the dist/ directory policy documentation in Git.
# Office binaries placed under dist/ are already ignored by the rules above.
#
# Use release-assets/ for local staging of generated binaries, hashes, manifests
# or files being prepared for a GitHub Release.
#------------------------------------------------------------------------------

release-assets/
build/
out/
output/
outputs/


#------------------------------------------------------------------------------
# REGRESSION / LOCAL TEST OUTPUT
#------------------------------------------------------------------------------
# The committed regression harness is source:
#
#   test/M_cDP_Test.bas
#
# Local output generated while investigating or automating tests is not.
#------------------------------------------------------------------------------

test-output/
test-results/
coverage/
.coverage

# Optional future local certification evidence. Published release evidence,
# when implemented, belongs in the GitHub Release process rather than being
# committed from a workstation accidentally.
DATETIMEPICKER_certification_*.json
DATETIMEPICKER_certification_*.txt


#------------------------------------------------------------------------------
# LOCAL TEMPORARY WORKING DIRECTORIES
#------------------------------------------------------------------------------

temp/
tmp/
.cache/


#------------------------------------------------------------------------------
# WINDOWS FILE-SYSTEM / SHELL METADATA
#------------------------------------------------------------------------------

Thumbs.db
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
System Volume Information/
*.stackdump

# Windows reserved-name artifact occasionally created by redirect/CLI mistakes
nul


#------------------------------------------------------------------------------
# MACOS / NETWORK / UNIX FILE-SYSTEM METADATA
#------------------------------------------------------------------------------
# The production target is Excel for Windows, but the repository may still be
# inspected or edited from macOS, WSL, containers, NAS shares, or CI runners.
#------------------------------------------------------------------------------

.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Trashes
.Spotlight-V100
.fseventsd

.directory
.fuse_hidden*
.nfs*


#------------------------------------------------------------------------------
# EDITOR / IDE / AI-ASSISTANT LOCAL STATE
#------------------------------------------------------------------------------
# Project-wide editor configuration can be added deliberately later by explicit
# exception. These defaults keep personal workspace state out of the repo.
#------------------------------------------------------------------------------

.vscode/
.idea/
.vs/
.history/

*.code-workspace
*.swp
*.swo
*~

# Notepad++ backup/session artifacts
*.nppBackup
session.xml

# Local assistant/editor state
.claude/
.cursor/
.aider*
.continue/


#------------------------------------------------------------------------------
# MERGE / PATCH / CONFLICT ARTIFACTS
#------------------------------------------------------------------------------
# Exported VBA files are large enough that accidental .orig/.rej files can look
# like legitimate modules. Never let conflict debris become project source.
#------------------------------------------------------------------------------

*.orig
*.rej
*.patch.tmp


#------------------------------------------------------------------------------
# LOGS / CRASH DUMPS / DIAGNOSTIC DEBRIS
#------------------------------------------------------------------------------

*.log
*.dmp
*.dump


#------------------------------------------------------------------------------
# LOCAL ENVIRONMENT / SECRET MATERIAL
#------------------------------------------------------------------------------
# Never commit workstation-specific environment files or private signing keys.
# Keep a deliberately sanitized example file trackable when one is introduced.
#------------------------------------------------------------------------------

.env
.env.*
!.env.example

*.pfx
*.p12
*.pvk
*.key


#------------------------------------------------------------------------------
# PYTHON / SCRIPTING CACHE AND LOCAL ENVIRONMENTS
#------------------------------------------------------------------------------
# Repository-maintenance or release tooling may use Python later. Source scripts
# remain trackable; interpreter caches and local virtual environments do not.
#------------------------------------------------------------------------------

__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

.venv/
venv/


#------------------------------------------------------------------------------
# NODE / JAVASCRIPT LOCAL DEPENDENCIES
#------------------------------------------------------------------------------
# Ribbon, documentation, or repository-quality tooling may use Node locally.
# Source/package manifests remain trackable; installed dependencies do not.
#------------------------------------------------------------------------------

node_modules/


#------------------------------------------------------------------------------
# KEEP THESE AUTHORITATIVE REPOSITORY ASSETS TRACKABLE
#------------------------------------------------------------------------------
# These comments are intentional guardrails for future maintenance.
#
# Production VBA source:
#   src/modules/*.bas
#   src/classes/*.cls
#   src/forms/*.frm
#   src/forms/*.frx
#
# Ribbon source:
#   src/ribbon/customUI14.xml
#
# Demo source:
#   demo/M_DEMO_BUILDER.bas
#   demo/M_DP_DEMO.bas
#
# Regression source:
#   test/M_cDP_Test.bas
#
# Documentation / governance:
#   README.md
#   CHANGELOG.md
#   CONTRIBUTING.md
#   SECURITY.md
#   CODE_OF_CONDUCT.md
#   dist/README.md
#
# Repository configuration / automation:
#   .gitignore
#   .gitattributes
#   .github/**
#
# Visual documentation:
#   assets/**
#   images/**
#
# Do not add broad ignore rules for source extensions or source directories.
# Generated Office binaries should be published as GitHub Release assets.
#==============================================================================
