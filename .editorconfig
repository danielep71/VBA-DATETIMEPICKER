#==============================================================================
# VBA-DATETIMEPICKER .editorconfig
#------------------------------------------------------------------------------
# PURPOSE
#   Keep exported modules, classes, UserForm text, RibbonX, workflows, and documentation consistent across editors.
#
# POLICY
#   - Exported VBA source uses CRLF and 4-space indentation.
#   - Repository text and cross-platform tooling use LF.
#   - Markdown preserves intentional two-space hard line breaks.
#   - VBA source encoding is not forced because the VBE exports text using the
#     Windows system code page.
#
# RELATIONSHIP WITH .gitattributes
#   .editorconfig controls editor behavior in the working tree. .gitattributes,
#   where present, remains authoritative for Git normalization, binary
#   classification, merge and diff behavior, Linguist, and archives.
#==============================================================================

root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
tab_width = 4

# Exported standard modules, class modules, and UserForm text definitions.
# Do not set charset here: preserve the VBE export contract.
[*.{bas,cls,frm}]
end_of_line = crlf
indent_style = space
indent_size = 4
tab_width = 4
insert_final_newline = true
trim_trailing_whitespace = true

# UF_DatePicker.frx is binary and is intentionally outside EditorConfig.
# XML uses compact two-space indentation.
[*.xml]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
tab_width = 2
insert_final_newline = true
trim_trailing_whitespace = true

# RibbonX package parts. src/ribbon/ mirrors the package's customUI/ folder
# and .gitattributes checks these parts out with CRLF, as Office writes them.
# These sections follow [*.xml] so they override its LF line ending. The
# shipped customUI.xml ends with a newline; the shipped .rels part does not,
# so editors must not add one there.
[src/ribbon/*.xml]
end_of_line = crlf

[src/ribbon/_rels/*.rels]
charset = utf-8
end_of_line = crlf
insert_final_newline = false
trim_trailing_whitespace = true

# Python tooling under tools/ and .github/scripts/.
[*.{py,pyw}]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
tab_width = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Node tooling under .github/scripts/.
[*.{js,mjs,cjs}]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
tab_width = 2
insert_final_newline = true
trim_trailing_whitespace = true

# GitHub workflows and structured configuration use two-space indentation.
[*.{yml,yaml,json,jsonc}]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
tab_width = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Documentation. Preserve intentional Markdown hard line breaks.
[*.md]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = false

[*.txt]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[{LICENSE,NOTICE}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Repository control files.
[{.editorconfig,.gitattributes,.gitignore,.gitkeep}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
