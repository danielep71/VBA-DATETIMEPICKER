#==============================================================================
# .gitattributes
#------------------------------------------------------------------------------
# PURPOSE
#   Define deterministic line-ending, binary, merge, diff, and reporting
#   behavior for a pure-VBA Excel component repository.
#
# POLICY
#   - Exported VBA source is CRLF in the working tree, matching the Windows VBE.
#   - Documentation, configuration, and cross-platform scripts are LF.
#   - Office packages, form binaries, archives, and media are never normalized
#     and are never line-merged.
#   - VBA source is reported to GitHub Linguist explicitly rather than by
#     extension heuristics.
#
# PLACEMENT
#   This file must live at the repository root. The [attr] macro definitions
#   below are only honored in a top-level .gitattributes; they are ignored in
#   subdirectory .gitattributes files.
#
# FIRST-TIME ADOPTION
#   Adding or changing text/eol attributes does not rewrite already-committed
#   blobs. After adding this file to an existing repository, run once:
#
#       git add --renormalize .
#       git commit -m "chore: normalize line endings per .gitattributes"
#
#   Do that as its own commit so the one-time normalization diff never mixes
#   with a functional change.
#
# OPTIONAL LOCAL CONFIG
#   The vba diff driver below is inert unless each clone defines it. To get
#   procedure names in diff hunk headers, run once per clone:
#
#       git config diff.vba.xfuncname \
#         "^[ \t]*((Public|Private|Friend)[ \t]+)?(Static[ \t]+)?(Sub|Function|Property[ \t]+(Get|Let|Set))[ \t]+.*$"
#
#   If it is not defined, Git silently falls back to default hunk headers.
#==============================================================================


#------------------------------------------------------------------------------
# MACRO DEFINITIONS
#------------------------------------------------------------------------------
# Named policies, so the intent of each rule below is stated once.
#   vba-source   Exported VBE text: CRLF working tree, VBA-aware diff, VBA stats
#   vba-form-bin Form binary companion: opaque, unmergeable, hidden from diffs
#   office-doc   Office package: opaque, unmergeable, excluded from stats
#   opaque       Any other binary payload: opaque and unmergeable
[attr]vba-source    text eol=crlf diff=vba linguist-language=VBA
[attr]vba-form-bin  binary merge=binary linguist-generated=true
[attr]office-doc    binary merge=binary linguist-detectable=false
[attr]opaque        binary merge=binary


#------------------------------------------------------------------------------
# DEFAULT TEXT DETECTION
#------------------------------------------------------------------------------
# Fallback for anything not classified below. Explicit rules always win.
* text=auto


#------------------------------------------------------------------------------
# EXPORTED VBA SOURCE
#------------------------------------------------------------------------------
# CRLF is required for predictable VBE import/export round-trips and prevents
# a contributor's operating system from producing line-ending-only diffs.
# .cls and .frm are ambiguous extensions to Linguist (LaTeX, Apex, VB6), so the
# language is declared rather than inferred.
*.bas   vba-source
*.cls   vba-source
*.frm   vba-source

# Binary companion emitted alongside an exported UserForm. A textual merge of
# this file corrupts the form; it must fail loudly instead.
*.frx   vba-form-bin


#------------------------------------------------------------------------------
# WINDOWS SCRIPTS AND HOST-SENSITIVE TEXT
#------------------------------------------------------------------------------
# These are consumed by Windows interpreters that can misbehave on LF input.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf
*.vbs   text eol=crlf
*.reg   text eol=crlf
*.ini   text eol=crlf


#------------------------------------------------------------------------------
# CROSS-PLATFORM SCRIPTS AND TOOLING SOURCE
#------------------------------------------------------------------------------
*.sh    text eol=lf
*.py    text eol=lf
*.pyw   text eol=lf


#------------------------------------------------------------------------------
# DOCUMENTATION AND CONFIGURATION
#------------------------------------------------------------------------------
*.md            text eol=lf
*.txt           text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.json          text eol=lf
*.jsonc         text eol=lf
*.xml           text eol=lf
*.csv           text eol=lf
*.tsv           text eol=lf
*.toml          text eol=lf
*.cfg           text eol=lf
*.svg           text eol=lf
.gitattributes  text eol=lf
.gitignore      text eol=lf
.gitkeep        text eol=lf
.editorconfig   text eol=lf
LICENSE         text eol=lf
CITATION.cff    text eol=lf


#------------------------------------------------------------------------------
# OFFICE PACKAGES
#------------------------------------------------------------------------------
# Zip containers. Never normalized, never line-merged, and excluded from the
# repository language breakdown so a demo workbook cannot skew it.
*.xls   office-doc
*.xlsx  office-doc
*.xlsm  office-doc
*.xlsb  office-doc
*.xlt   office-doc
*.xltx  office-doc
*.xltm  office-doc
*.xlam  office-doc
*.xla   office-doc

*.doc   office-doc
*.docx  office-doc
*.docm  office-doc
*.dotx  office-doc
*.ppt   office-doc
*.pptx  office-doc
*.pptm  office-doc
*.potx  office-doc

*.accdb office-doc
*.mdb   office-doc


#------------------------------------------------------------------------------
# ARCHIVES AND DISTRIBUTION ARTIFACTS
#------------------------------------------------------------------------------
*.zip   opaque
*.7z    opaque
*.rar   opaque
*.gz    opaque
*.tgz   opaque
*.cab   opaque
*.msi   opaque
*.exe   opaque
*.dll   opaque
*.ocx   opaque
*.tlb   opaque


#------------------------------------------------------------------------------
# IMAGES AND MEDIA
#------------------------------------------------------------------------------
# Note: .svg is text and is handled in the documentation section above.
*.png   opaque
*.jpg   opaque
*.jpeg  opaque
*.gif   opaque
*.webp  opaque
*.bmp   opaque
*.ico   opaque
*.tif   opaque
*.tiff  opaque
*.pdf   opaque
*.mp4   opaque
*.gifv  opaque
*.ttf   opaque
*.otf   opaque
*.woff  opaque
*.woff2 opaque


#------------------------------------------------------------------------------
# LANGUAGE REPORTING
#------------------------------------------------------------------------------
# Keep the GitHub language bar representative of the component itself.
# Screenshots, banners, and social previews carry no language signal but are
# marked explicitly so intent is recorded rather than inferred.
assets/**   linguist-vendored
images/**   linguist-vendored


#------------------------------------------------------------------------------
# ARCHIVE AND RELEASE HYGIENE
#------------------------------------------------------------------------------
# Excluded from `git archive`, which is what produces the GitHub source ZIP and
# release tarballs. Repository plumbing is not part of a consumable release.
# Note: `git archive` honors the eol attribute, so exported VBA source arrives
# CRLF in the ZIP regardless of the machine that generated it.
.gitattributes  export-ignore
.gitignore      export-ignore
.github/        export-ignore
.editorconfig   export-ignore


#==============================================================================
# OPTIONAL — ENABLE PER REPOSITORY
#------------------------------------------------------------------------------
# Uncomment only what applies. Each line is inert while commented.
#
# Generated evidence artifacts: keep them versioned and diffable, but collapsed
# by default in pull requests and excluded from language statistics.
#   benchmark/**/*.csv  linguist-generated=true
#   benchmark/**/*.md   linguist-generated=true
#
# ANSI-encoded VBA exports. The VBE writes .bas/.cls/.frm in the system code
# page, not UTF-8, so any non-ASCII character (accented letters, en dashes,
# typographic quotes) is stored as a byte GitHub cannot render. This converts
# to UTF-8 in the repository and back to Windows-1252 in the working tree.
#
# Before enabling, confirm the files are actually non-ASCII and non-UTF-8:
#   git ls-files -z '*.bas' '*.cls' '*.frm' | xargs -0 file --mime-encoding
#
# Requires Git 2.18+ in every clone, and a renormalization commit. Git verifies
# the round-trip and warns if a file cannot convert cleanly. If the sources are
# pure ASCII, leave this off — it buys nothing and adds a compatibility floor.
#   *.bas  working-tree-encoding=windows-1252
#   *.cls  working-tree-encoding=windows-1252
#   *.frm  working-tree-encoding=windows-1252
#==============================================================================
